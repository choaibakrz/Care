# Example values only. Copy to .env and adjust. No secrets here.
# Every variable has a default (shown); a variable set in the environment wins over .env.
DATABASE_URL=sqlite://data/clinic.db?mode=rwc
JOURNAL_DIR=journal

# Listen address. HACKATHON: the default is every interface (0.0.0.0:8080) so phones and
# laptops on the LAN connect; set 127.0.0.1:8080 for this computer only (the normal default,
# restore after the pitch). See docs/dev-setup.md "Hackathon open mode".
# CLINIC_BIND=0.0.0.0:8080
# Folder of the built admin console served at /admin/ (default ../admin/dist).
# ADMIN_WEB_DIR=../admin/dist

# Browser origins allowed by CORS (comma-separated, never *). Default: the admin console's
# dev and preview servers.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Origins allowed to open /ws (default: the same list as CORS_ORIGINS).
# WS_ORIGINS=
# WS_ALLOW_MISSING_ORIGIN=true

# Request limits.
# MAX_BODY_BYTES=65536
# REQUEST_TIMEOUT_S=10
# MAX_IN_FLIGHT=256
# RATE_PER_SECOND=20
# RATE_BURST=40

# Known networks (not read with --mock) and trusted proxies.
# KNOWN_NETWORKS_FILE=seed/known_networks.json
# TRUSTED_PROXIES=

# Seed files.
# SEED_DIR=seed
# MAP_PATH=seed/clinic_map.json
# ROLE_CARDS_PATH=seed/role_cards.json
# DEMO_FLEET_PATH=seed/demo_fleet.json
# DOCK_PLACE=dock-a

# Journal and logs.
# JOURNAL_KEY=keys/journal.key
# JOURNAL_ANCHORS=anchor/anchor.log
# JOURNAL_ESTOP_FALLBACK=estop-fallback.log
# LOG_DIR=logs
# JOURNAL_SEAL_INTERVAL_S=60
# JOURNAL_SEGMENT_MAX_BYTES=67108864
# JOURNAL_BATCH_FSYNC_MS=1000

# Login token lifetime (seconds).
# TOKEN_TTL_S=43200

# Pseudonymous accounts (Task A7, docs/accounts.md). The clinic id in the key derivation's salt:
# fixed for the life of an installation (changing it means everyone enrols again).
# ACCOUNT_CLINIC_ID=demo-clinic
# The pepper key file (32 bytes, hex): created on first start, refused when readable by other
# users, never logged. Back it up with the journal key: without it nobody can log in.
# ACCOUNT_PEPPER=keys/account.pepper

# Emergency service status stream (unset: the mirror is off).
# EMERGENCY_STATUS_URL=
# EMERGENCY_SILENCE_S=10

# Server-side brain (Task A6, docs/brain.md). Both clinic-server and clinic-brain read these.
# Unset BRAIN_TOKEN: clinic-brain refuses to start, clinic-server reports brain: down.
# BRAIN_TOKEN=
# BRAIN_URL=http://127.0.0.1:8091
# Timeouts nested outer > inner (ruling R22); both programs refuse a broken nesting.
# BRAIN_ROUTE_TIMEOUT_S=30
# BRAIN_TIMEOUT_S=25
# BRAIN_BIND=127.0.0.1:8091
# BRAIN_REPO_ROOT=../..
# BRAIN_VENV=../../.venv
# BRAIN_CALL_TIMEOUT_S=20
# BRAIN_QUEUE=8

# --- Monitoring, rate limit and blocks (Task A8; monitoring-security.md) ---
# RATE_PER_SECOND and RATE_BURST above are the per-address limit (20/s, burst 40).
# Over the limit this many seconds in a row: blocked automatically.
# AUTO_BLOCK_AFTER_S=5
# How long an automatic block lasts, seconds.
# AUTO_BLOCK_FOR_S=600
# Failed POST /auth/login from one address within the window that block it.
# LOGIN_FAILURES_MAX=10
# Not longer than MONITOR_WINDOW_S; also used for refused tokens (401).
# LOGIN_FAILURES_WINDOW_S=60
# How long per-address counters are kept in memory (never on disk), seconds.
# MONITOR_WINDOW_S=300
# At most one rate_limited security.alert per address in this interval, seconds.
# RATE_ALERT_INTERVAL_S=60
# The emergency service's addresses or CIDR blocks (at most /16 or /48): never limited,
# never blocked.
# EMERGENCY_SERVICE_ADDRESSES=
# GET /stats/service: places with fewer requests are folded into "other" (0 = off; 3 for
# k-anonymity on small wards).
# SERVICE_STATS_MIN_COUNT=0
